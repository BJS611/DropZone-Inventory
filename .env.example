APP_NAME="DropZone Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dropzone_inventory
DB_USERNAME=dropzone
DB_PASSWORD=dropzone

SESSION_DRIVER=database
SESSION_CONNECTION=null
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Konfigurasi deploy Vercel (lihat AGENTS.md bagian 36/26)
# APP_URL=https://your-domain.vercel.app
# ASSET_URL=https://your-domain.vercel.app
